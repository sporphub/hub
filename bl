    or (typeof(fluxus) == "table" and typeof(fluxus.request) == "function" and fluxus.request)

local function getHWID()
    local function try(fn)
        if typeof(fn) ~= "function" then return nil end
        local ok, value = pcall(fn)
        return ok and value and tostring(value) or nil
    end

    local value = try(gethwid) or try(get_hwid) or try(getdeviceid)
    if value then return value end
    return "USER_" .. tostring(game.Players.LocalPlayer.UserId)
end

local function copyToClipboard(value)
    local fn = (typeof(setclipboard) == "function" and setclipboard)
        or (typeof(toclipboard) == "function" and toclipboard)
    if not fn then return false end
    return pcall(fn, value)
end

local function fetchPayload(key)
    if not httpRequest then return nil, "Executor does not support HTTP requests." end

    local ok, response = pcall(httpRequest, {
        Url = CONFIG.WorkerUrl,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({
            key = key,
            provider = "buyer",
            hwid = getHWID(),
        }),
    })

    if not ok or not response then return nil, "Key service unavailable." end
    if tonumber(response.StatusCode) == 200 then return response.Body end
    if tonumber(response.StatusCode) == 403 then return nil, response.Body or "Invalid or shared key." end
    return nil, "Key service unavailable."
end

local function runPayload(payload)
    local chunk, err = loadstring(payload)
    if not chunk then error("Script payload failed to load: " .. tostring(err)) end
    chunk()
end

