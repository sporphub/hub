    end
end)

spawnTask(function()
    if not CONFIG.SaveKey or not safeExists or not safeRead then return end
    local ok, exists = pcall(safeExists, CONFIG.SaveKeyPath)
    if not ok or not exists then return end
    local readOk, key = pcall(safeRead, CONFIG.SaveKeyPath)
    if readOk and type(key) == "string" and key ~= "" then
        showStatus("Checking saved key...", COLORS.muted)
        validate(key, true)
    end
end)
