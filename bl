local busy = false
local function showStatus(message, color)
    status.Text = message
    status.TextColor3 = color or COLORS.muted
end

local function finish(payload)
    TweenService:Create(overlay, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
    TweenService:Create(card, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
    task.wait(0.3)
    gui:Destroy()
    runPayload(payload)
end

local function validate(key, saved)
    if busy then return end
    key = key:gsub("%s+", "")
    if key == "" then
        showStatus("Enter your buyer key first.", COLORS.error)
        return
    end

    busy = true
    verify.Text = "Verifying..."
    verify.BackgroundColor3 = COLORS.primaryHover
    showStatus("Checking device binding...", COLORS.muted)

    local payload, err = fetchPayload(key)
    if not payload then
        busy = false
        verify.Text = "Verify Access"
        verify.BackgroundColor3 = COLORS.primary
        showStatus(err, COLORS.error)
        return
    end

    if CONFIG.SaveKey and not saved and safeWrite then
        pcall(safeWrite, CONFIG.SaveKeyPath, key)
    end

    showStatus("Access verified.", COLORS.primary)
    finish(payload)
end

