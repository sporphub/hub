local function isDeltaExecutor()
    -- Check via identifyexecutor() / getexecutorname()
    if identifyexecutor then
        local name, version = identifyexecutor()
        if type(name) == "string" and name:lower():find("delta") then
            return true
        end
    end
    
    if getexecutorname then
        local name = getexecutorname()
        if type(name) == "string" and name:lower():find("delta") then
            return true
        end
    end

    -- Check for Delta-specific globals or flags
    if DELTA_LOADED ~= nil or getgenv().DELTA_LOADED ~= nil then
        return true
    end

    return false
end

