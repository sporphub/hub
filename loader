-- ==========================================
--  SAFE EXECUTOR DETECTION & KICK SCRIPT
-- ==========================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Safe function call helper
local function safeCall(fn)
    if type(fn) == "function" then
        local success, result = pcall(fn)
        if success and type(result) == "string" then
            return result
        end
    end
    return nil
end

-- Safely identify the current executor
local function getExecutor()
    -- 1. Check custom Xeno globals
    if rawget(_G, "Xeno") ~= nil or (getgenv and rawget(getgenv(), "Xeno") ~= nil) then
        return "Xeno"
    end
    
    -- 2. Check custom Delta globals
    if rawget(_G, "DELTA_LOADED") ~= nil or (getgenv and rawget(getgenv(), "DELTA_LOADED") ~= nil) then
        return "Delta"
    end

    -- 3. Safely call identifyexecutor if it exists
    local name = safeCall(identifyexecutor) or safeCall(getexecutorname)
    if name then
        return name
    end

    return "Unknown"
end

-- ==========================================
--  EXECUTION & KICK LOGIC
-- ==========================================

local currentExecutor = getExecutor():lower()

if currentExecutor:find("delta") then
    LocalPlayer:Kick("\n[Security Alert]\nDelta Executor is not allowed in this game.")

elseif currentExecutor:find("xeno") then
    LocalPlayer:Kick("\n[Security Alert]\nXeno Executor is not allowed in this game.")

else
    print("[+] Executor allowed or unrecognized (" .. currentExecutor .. "). Running main script...")
    
    -- Your main script execution goes here:
    -- loadstring(game:HttpGet("https://raw.githubusercontent.com/.../main_script.lua"))()
end
